{
  "name": "MGA SOC Laboratory Management",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/mga-lab",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "MGA Laboratory Management",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "initializeCommand": [
    "bash",
    "scripts/codespaces-initialize.sh"
  ],
  "overrideCommand": false
}
