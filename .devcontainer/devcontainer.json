{
  "name": "MGA SOC Laboratory Management",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/mga-lab",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "MGA Laboratory Management",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash scripts/codespaces-setup.sh",
  "postStartCommand": "bash scripts/codespaces-start.sh > /tmp/mga-next.log 2>&1 &",
  "initializeCommand": [
    "bash",
    "scripts/codespaces-initialize.sh"
  ]
}
